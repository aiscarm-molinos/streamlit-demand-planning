# Copiar este archivo a "ibp.env" y "aws.env" (en la raíz del proyecto) y
# completar con valores reales. Ninguno de los dos se commitea (ver .gitignore).

# ---- ibp.env: SAP IBP OData ----
# IBP_USERNAME=
# IBP_PASSWORD=
# IBP_BASE_URL=            # ej. https://<host>/sap/opu/odata/IBP/PA_DEMAND
# IBP_PA_DEMANDA=          # nombre del resource/entidad OData (ej. PLANNINGDATA)

# ---- aws.env: AWS Athena (Data Lake) ----
# AWS_PROFILE=             # perfil de AWS CLI/SSO local (no hace falta si usás aws_credentials.env)
# AWS_REGION=
# AWS_DATABASE=            # ej. molinos_datalake_datapreparation
# AWS_S3_STAGING=          # bucket/prefijo S3 donde Athena deja resultados de queries

# ---- aws_credentials.env (opcional): credenciales explícitas de AWS ----
# Alternativa a AWS_PROFILE cuando no hay un perfil SSO configurado en la
# máquina. Si se completan estas variables, tienen prioridad sobre AWS_PROFILE.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=       # solo si son credenciales temporales (ej. exportadas de un login SSO)

# ---- s3_sagemaker.env: AWS S3 (Experimentos SageMaker) ----
# Cuenta/rol DISTINTOS a los de aws.env/aws_credentials.env (Athena):
# cuenta "AI_Platform_DEV", rol "MRP_Analistas_IBP_AWS". Ese rol hoy solo
# tiene permiso de listar (ListBucket) -- no de descargar (GetObject) --,
# así que la app cae a modo local (ver sample_data/sagemaker/) para
# explorar el contenido de un model.tar hasta que se sumen permisos.
# AWS_PROFILE_SAGEMAKER=          # perfil de AWS CLI/SSO local para el rol MRP_Analistas_IBP_AWS (no hace falta si usás las credenciales explícitas de abajo)
# AWS_REGION_SAGEMAKER=
# AWS_S3_SAGEMAKER_BUCKET=        # ej. ibp-forecast-sagemaker-data-595365649575
# AWS_S3_SAGEMAKER_PREFIX=        # ej. ibp-forecast-mensual (SIN "/exp" -- se arma solo, ver aws_s3_experimentos.py) -- sin "/" final
# AWS_ACCESS_KEY_ID_SAGEMAKER=    # credenciales explícitas, alternativa a AWS_PROFILE_SAGEMAKER
# AWS_SECRET_ACCESS_KEY_SAGEMAKER=
# AWS_SESSION_TOKEN_SAGEMAKER=    # solo si son credenciales temporales
