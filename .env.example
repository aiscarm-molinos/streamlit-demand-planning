# Copiar este archivo a "ibp.env" y "aws.env" (en la raíz del proyecto) y
# completar con valores reales. Ninguno de los dos se commitea (ver .gitignore).

# ---- ibp.env: SAP IBP OData ----
# IBP_USERNAME=
# IBP_PASSWORD=
# IBP_BASE_URL=            # ej. https://<host>/sap/opu/odata/IBP/PA_DEMAND
# IBP_PA_DEMANDA=          # nombre del resource/entidad OData (ej. PLANNINGDATA)

# ---- aws.env: AWS Athena (Data Lake) ----
# AWS_PROFILE=             # perfil de AWS CLI/SSO local (no hace falta si usás aws_credentials.env)
# AWS_REGION=
# AWS_DATABASE=            # ej. molinos_datalake_datapreparation
# AWS_S3_STAGING=          # bucket/prefijo S3 donde Athena deja resultados de queries

# ---- aws_credentials.env (opcional): credenciales explícitas de AWS ----
# Alternativa a AWS_PROFILE cuando no hay un perfil SSO configurado en la
# máquina. Si se completan estas variables, tienen prioridad sobre AWS_PROFILE.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=       # solo si son credenciales temporales (ej. exportadas de un login SSO)
